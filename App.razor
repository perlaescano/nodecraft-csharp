<Router AppAssembly="@typeof(App).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" />
    </Found>
    <NotFound>
        <PageTitle>Not found</PageTitle>
        <p role="alert" style="padding: 20px; font-family: sans-serif;">Sorry, there's nothing at this address.</p>
    </NotFound>
</Router>
